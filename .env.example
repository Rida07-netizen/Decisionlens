# Postgres connection string (Neon, or Vercel's Postgres integration).
# Vercel sets this automatically once you attach the database to the project;
# copy it into a local .env only if you want to run `npm run server` locally
# or run the one-off migration.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vercel Blob read/write token. Set automatically on Vercel once a Blob store
# is attached to the project. Needed locally only to run the migration.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# --- AI Assistant (optional) ---
# Get a key at https://openrouter.ai/keys. Without this set, the AI
# Assistant page still works, but only answers the fixed set of questions
# its local rule engine recognizes (see server/index.js -> answerFromData).
# With it set, generic/paraphrased questions are answered by a real model
# instead. NEVER commit a real key to this file or to git — set it in
# Vercel's Environment Variables, and put a real value only in a local
# .env / .env.local that stays out of version control (see .gitignore).
OPENROUTER_API_KEY=

# Which OpenRouter model to use. Defaults to "openrouter/free" (OpenRouter's
# own router across whatever free models are currently available) if this is
# left unset — specific ":free" model IDs get renamed/retired often enough
# that hardcoding one tends to break within a few months.
OPENROUTER_MODEL=openrouter/free

# Student names ARE sent to OpenRouter by default, because the assistant
# needs to recognize a real name typed into a question (e.g. "how is Ayesha
# Khan doing") — an anonymized roster can't be matched against that. Several
# free OpenRouter models log prompts to improve the model, so be aware
# student data can leave your server this way. Set to "true" to anonymize
# the roster instead — at the cost of no longer being able to answer
# questions that name a specific student.
AI_ASSISTANT_ANONYMIZE=false
